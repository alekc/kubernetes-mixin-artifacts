{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Track the Kubernetes Mixin release pinned in download.sh",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)download\\.sh$/"],
      "matchStrings": ["VERSION=\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-monitoring/kubernetes-mixin",
      "extractVersionTemplate": "^version-(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ]
}
